[Unit]
Description=Go Fast Note Sync daemon
Documentation=https://github.com/liu-zhengdong/go-fast-note-sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment="HOME=%h"
EnvironmentFile=-%h/.config/go-fast-note-sync/sync.env
ExecStart=%h/.local/bin/go-fast-note-sync start --config %h/.config/go-fast-note-sync/config.yaml
Restart=on-failure
RestartSec=5s
# The daemon stops on SIGTERM. If a callback is still wedged, do not require kill -9.
TimeoutStopSec=20s
KillSignal=SIGTERM

[Install]
WantedBy=default.target
